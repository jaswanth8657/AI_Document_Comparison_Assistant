# ==============================================================================
# AI DOCUMENT COMPARISON ASSISTANT - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env':
#      copy .env.example .env
# 2. Paste your Google AI Studio Gemini API key below.
# 3. Never commit your actual '.env' file to Git or share it publicly.
# ==============================================================================

# Required: Google Gemini API Key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Configured Gemini Model: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Optional: Document Guardrails & Processing Limits
MAX_FILE_SIZE_MB=15
MAX_PAGES_PER_DOC=50
MAX_CHARS_PER_DOC=60000
MAX_TOTAL_CHARS=120000

# Optional: Generation Parameters
GEMINI_TEMPERATURE=0.2
GEMINI_TOP_P=0.95

